{
  "name": "sidekick",
  "version": "2.1.0",
  "description": "Sidekick — Autonomous Agent Platform",
  "main": "src/index.js",
  "bin": {
    "sidekick": "src/cli.js",
    "sidekick-compute-worker": "src/compute/worker-agent.js",
    "sidekick-execution-node": "src/node/agent.js"
  },
  "files": [
    "src",
    "packs",
    "migrations",
    "scripts",
    "README.md",
    "docs",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dashboard": "node src/dashboard.js",
    "agent": "node src/agent.js",
    "certify": "node src/cli.js certify",
    "package:worker": "node scripts/build-worker-package.js",
    "manifest:release": "node scripts/generate-release-manifest.js",
    "pack:inventory": "node scripts/generate-pack-inventory.js",
    "sbom:release": "npm sbom --sbom-format cyclonedx --sbom-type application",
    "seed:knowledge": "node scripts/seed-knowledge.js",
    "test": "node test/run-all.js",
    "test:ci": "node test/run-all.js",
    "test:certification": "node test/run-all.js test/certification.test.js test/certification-isolation.test.js test/certification-lifecycle.test.js test/artifact-resource-scope.test.js test/compute-artifact-custody.test.js test/execution-node-protocol.test.js",
    "test:security": "node test/security.test.js",
    "test:brain-v3": "NODE_ENV=test node test/brain-v3-foundations.test.js && NODE_ENV=test node scripts/evaluate-brain-v3.js",
    "check:architecture": "node scripts/check-architecture.js",
    "check:docs": "node scripts/check-docs.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/server-legacy": "^2.0.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.7.0",
    "handlebars": "^4.7.8",
    "ignore": "7.0.6",
    "ini": "^7.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "playwright-core": "1.62.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-perl": "1.2.1",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "tree-sitter-perl@1.2.1": true
  }
}
