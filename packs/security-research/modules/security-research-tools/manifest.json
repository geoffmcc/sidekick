{
  "name": "security-research-tools",
  "displayName": "Security Research Tools",
  "version": "1.2.0",
  "description": "Governed security-research orchestration: campaigns, hypotheses, durable runs, bounded probes, evidence with integrity and redaction, deterministic comparison, validation and report material. Command probes dispatch bash and http probes dispatch web_fetch; labelled disposable lab profiles expose target, egress, topology and rollback metadata while provider actions remain guarded; workflows compose git. All through the Sidekick policy/approval/audit path. Enforces a hard boundary between the public repository and an external private research workspace.",
  "author": "Sidekick",
  "type": "plugin",
  "entryPoint": "entry.js",
  "sidekick": ">=1.0.0",
  "capabilities": [
    "research-campaign-management",
    "research-hypothesis-lifecycle",
    "research-run-orchestration",
    "bounded-probe-execution",
    "evidence-integrity-and-redaction",
    "behavioral-comparison-and-validation",
    "report-material",
    "governed-source-snapshots",
    "registered-source-indexing",
    "declared-source-authority-claims"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "workspace": {
        "type": "string",
        "description": "Absolute path to the EXTERNAL private research workspace, outside the Sidekick source repository. When unset, SIDEKICK_RESEARCH_WORKSPACE is used."
      },
      "allow_local_probes": {
        "type": "boolean",
        "description": "Permit command probes on the Sidekick host process (workdir confined to the workspace). Default false."
      },
      "probe_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
      "max_evidence_bytes": { "type": "integer", "minimum": 1024, "maximum": 104857600 },
      "source_limits": {
        "type": "object",
        "properties": {
          "max_files": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "max_bytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
          "max_depth": { "type": "integer", "minimum": 1, "maximum": 32 },
          "max_path_bytes": { "type": "integer", "minimum": 1, "maximum": 4096 }
        },
        "additionalProperties": false
      },
      "http": {
        "type": "object",
        "properties": {
          "allowed_hosts": { "type": "array", "items": { "type": "string" } },
          "allow_private_addresses": { "type": "boolean" },
          "network_scope": { "type": "string", "maxLength": 80 },
          "max_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 52428800 }
        },
        "additionalProperties": false
      },
      "environments": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["local", "disposable", "proxmox", "remote"] },
            "isolation": { "type": "string", "enum": ["isolated", "shared"] },
            "network_mode": { "type": "string", "enum": ["none", "fixture", "lab"] },
            "production_access": { "type": "boolean" },
            "provider_profile": { "type": "string" },
            "lab_profile": { "type": "string" },
            "environment_label": { "type": "string" },
            "target_allowlist": { "type": "array", "items": { "type": "string" } },
            "egress": { "type": "string", "enum": ["none", "restricted"] },
            "rollback": { "type": "object" },
            "topology": { "type": "object" },
            "provision": { "type": "object" },
            "workdir": { "type": "string" },
            "description": { "type": "string" }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      },
      "lab_profiles": { "type": "object", "additionalProperties": { "type": "object" } }
    },
    "additionalProperties": false
  },
  "tools": {
    "research_status": { "risk": "low", "category": "Security", "aliases": ["research_health"] },
    "research_project": { "risk": "medium", "category": "Security", "aliases": ["research_campaign"] },
    "research_hypothesis": { "risk": "medium", "category": "Security", "aliases": [] },
    "research_scope": { "risk": "medium", "category": "Security", "aliases": [] },
    "research_run": { "risk": "high", "category": "Security", "aliases": [] },
    "research_probe": { "risk": "high", "category": "Security", "aliases": [] },
    "research_evidence": { "risk": "medium", "category": "Security", "aliases": [] },
    "research_compare": { "risk": "low", "category": "Security", "aliases": [] },
    "research_validate": { "risk": "medium", "category": "Security", "aliases": [] },
    "research_report": { "risk": "medium", "category": "Security", "aliases": [] },
    "research_source": { "risk": "high", "category": "Security", "aliases": [] }
  },
  "permissions": [
    { "tool": "semantic_repo", "risk": "low" },
    { "tool": "bash", "risk": "critical" },
    { "tool": "web_fetch", "risk": "medium" },
    { "tool": "proxmox_provision", "risk": "high" },
    { "tool": "proxmox_guest", "risk": "high" },
    { "tool": "proxmox_retire", "risk": "critical" },
    { "tool": "git", "risk": "medium" }
  ],
  "lifecycle": {
    "disable": "stop_new_work",
    "uninstall": "retain_data"
  }
}
