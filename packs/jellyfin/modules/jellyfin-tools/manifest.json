{
  "name": "jellyfin-tools",
  "displayName": "Jellyfin Tools",
  "version": "1.4.1",
  "description": "Secure, bounded Jellyfin media inventory, inspection, diagnosis, log intelligence, evidence-based readiness checks and governed maintenance.",
  "sidekick": ">=1.0.0",
  "type": "plugin",
  "entryPoint": "entry.js",
  "capabilities": [
    "jellyfin-discovery",
    "jellyfin-media-inventory",
    "jellyfin-catalog-audit",
    "jellyfin-live-tv-inspection",
    "jellyfin-server-audit",
    "jellyfin-user-media",
    "jellyfin-playback-control",
    "jellyfin-analytics",
    "jellyfin-playback-diagnosis",
    "jellyfin-log-intelligence",
    "jellyfin-storage-preflight",
    "jellyfin-maintenance"
  ],
  "configSchema": { "type": "object" },
  "permissions": [
    { "tool": "proxmox", "risk": "low" },
    { "tool": "status", "risk": "medium" },
    { "tool": "web_fetch", "risk": "medium" }
  ],
  "tools": {
    "jellyfin": { "risk": "low", "category": "Media", "aliases": ["jf"] },
    "jellyfin_maintenance": { "risk": "high", "category": "Media", "aliases": ["jf_maintenance"] },
    "jellyfin_playback": { "risk": "high", "category": "Media", "aliases": ["jf_playback"] }
  },
  "lifecycle": { "disable": "stop_new_work", "uninstall": "retain_data" }
}
