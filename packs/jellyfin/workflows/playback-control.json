{"schema_version":1,"name":"jellyfin/playback-control","version":"1.0.0","title":"Jellyfin Targeted Playback Control","description":"Send a governed playback control command to a uniquely resolved active Jellyfin device session, after confirming current sessions.","mode":"mutating","inputs":{"profile":{"type":"string","required":false,"default":""},"action":{"type":"string","required":true,"enum":["play","pause","resume","stop","seek","fast_forward","rewind","set_volume"],"description":"Playback control command"},"session_id":{"type":"string","required":false,"default":"","description":"Exact active session id selector"},"device_id":{"type":"string","required":false,"default":"","description":"Exact device id selector"},"device_name":{"type":"string","required":false,"default":"","description":"Case-insensitive exact device name selector"},"item_id":{"type":"string","required":false,"default":"","description":"Item to play (required when action is play)"},"position_seconds":{"type":"number","required":false,"description":"Absolute seek target in seconds"},"offset_seconds":{"type":"number","required":false,"description":"Relative seek offset in seconds"},"volume":{"type":"number","required":false,"description":"Target volume 0-100 for set_volume"}},"steps":[{"name":"sessions","title":"Active sessions","tool":"jellyfin","args":{"action":"list_sessions","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"},{"name":"control","title":"Send control command","tool":"jellyfin_playback","args":{"action":"${inputs.action}","profile":"${inputs.profile}","session_id":"${inputs.session_id}","device_id":"${inputs.device_id}","device_name":"${inputs.device_name}","item_id":"${inputs.item_id}","position_seconds":"${inputs.position_seconds}","offset_seconds":"${inputs.offset_seconds}","volume":"${inputs.volume}"},"expect":"json","on_error":"fail"}],"result":{"sessions":"${steps.sessions.json}","control":"${steps.control.json}"},"tags":["jellyfin","playback","control"]}