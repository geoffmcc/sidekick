{"schema_version":1,"name":"jellyfin/play-now","version":"1.0.0","title":"Jellyfin Play on Device","description":"Start playback of a known Jellyfin item on a named active device session, after confirming current sessions and the user's resume list.","mode":"mutating","inputs":{"profile":{"type":"string","required":false,"default":""},"device_name":{"type":"string","required":true,"description":"Exact case-insensitive active session device name, e.g. \"Geoffs TV\""},"username":{"type":"string","required":false,"default":""},"item_id":{"type":"string","required":true,"description":"Jellyfin item id to play"}},"steps":[{"name":"sessions","title":"Active sessions","tool":"jellyfin","args":{"action":"list_sessions","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"},{"name":"resume","title":"User resume list","tool":"jellyfin","args":{"action":"continue_watching","profile":"${inputs.profile}","username":"${inputs.username}"},"expect":"json","on_error":"continue"},{"name":"play","title":"Play on device","tool":"jellyfin_playback","args":{"action":"play","profile":"${inputs.profile}","device_name":"${inputs.device_name}","item_id":"${inputs.item_id}"},"expect":"json","on_error":"fail"}],"result":{"sessions":"${steps.sessions.json}","resume":"${steps.resume.json}","play":"${steps.play.json}"},"tags":["jellyfin","playback","control"]}