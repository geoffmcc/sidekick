{"schema_version":1,"name":"jellyfin/incident","version":"1.1.0","title":"Jellyfin Incident Evidence","description":"Collect a bounded Jellyfin-side incident snapshot; each step's result carries its own evidence, no source is claimed unless its step succeeded.","mode":"read_only","inputs":{"profile":{"type":"string","required":false,"default":""}},"steps":[{"name":"profile","title":"Profile","tool":"jellyfin","args":{"action":"server_profile","profile":"${inputs.profile}"},"expect":"json","on_error":"fail"},{"name":"diagnosis","title":"Incident diagnosis","tool":"jellyfin","args":{"action":"incident_diagnose","profile":"${inputs.profile}","limit":50},"expect":"json","on_error":"continue"},{"name":"logs","title":"Log summary","tool":"jellyfin","args":{"action":"logs_summary","profile":"${inputs.profile}"},"expect":"json","on_error":"continue"},{"name":"activity","title":"Activity","tool":"jellyfin","args":{"action":"activity","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"},{"name":"sessions","title":"Sessions","tool":"jellyfin","args":{"action":"list_sessions","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"},{"name":"tasks","title":"Tasks","tool":"jellyfin","args":{"action":"list_tasks","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"}],"result":{"profile":"${steps.profile.json}","diagnosis":"${steps.diagnosis.json}","logs":"${steps.logs.json}","activity":"${steps.activity.json}","sessions":"${steps.sessions.json}","tasks":"${steps.tasks.json}"},"tags":["jellyfin","incident","read-only"]}
