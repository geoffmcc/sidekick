{"schema_version":1,"name":"jellyfin/play-resume","version":"1.0.0","title":"Jellyfin Play Resume Item","description":"Start playback of the top continue-watching item for a user on a named active device session, after confirming current sessions and the user's resume list.","mode":"mutating","inputs":{"profile":{"type":"string","required":false,"default":""},"device_name":{"type":"string","required":true,"description":"Exact case-insensitive active session device name, e.g. \"Geoffs TV\""},"username":{"type":"string","required":true,"description":"Jellyfin user whose resume list is resolved"}},"steps":[{"name":"sessions","title":"Active sessions","tool":"jellyfin","args":{"action":"list_sessions","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"},{"name":"resume","title":"User resume list","tool":"jellyfin","args":{"action":"continue_watching","profile":"${inputs.profile}","username":"${inputs.username}","limit":5,"start_index":0},"expect":"json","on_error":"continue"},{"name":"play","title":"Play on device","tool":"jellyfin_playback","args":{"action":"play","profile":"${inputs.profile}","device_name":"${inputs.device_name}","item_id":"${steps.resume.json.items[0].id}"},"expect":"json","on_error":"fail"}],"result":{"sessions":"${steps.sessions.json}","resume":"${steps.resume.json}","play":"${steps.play.json}"},"tags":["jellyfin","playback","control"]}