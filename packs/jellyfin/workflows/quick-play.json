{"schema_version":1,"name":"jellyfin/quick-play","version":"1.0.0","title":"Jellyfin Quick Play Search Result","description":"Search Jellyfin for a media title and start playback of the top matching item on a named active device session, after confirming current sessions.","mode":"mutating","inputs":{"profile":{"type":"string","required":false,"default":""},"device_name":{"type":"string","required":true,"description":"Exact case-insensitive active session device name, e.g. \"Geoffs TV\""},"query":{"type":"string","required":true,"description":"Media title to search for"},"include_item_types":{"type":"string","required":false,"default":"Episode,Movie"}},"steps":[{"name":"sessions","title":"Active sessions","tool":"jellyfin","args":{"action":"list_sessions","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"},{"name":"search","title":"Search media","tool":"jellyfin","args":{"action":"search_media","profile":"${inputs.profile}","query":"${inputs.query}","include_item_types":"${inputs.include_item_types}","limit":10,"start":0},"expect":"json","on_error":"continue"},{"name":"play","title":"Play on device","tool":"jellyfin_playback","args":{"action":"play","profile":"${inputs.profile}","device_name":"${inputs.device_name}","item_id":"${steps.search.json.items[0].id}"},"expect":"json","on_error":"fail"}],"result":{"sessions":"${steps.sessions.json}","search":"${steps.search.json}","play":"${steps.play.json}"},"tags":["jellyfin","playback","control"]}