{"schema_version":1,"name":"jellyfin/play-next","version":"1.0.0","title":"Jellyfin Play Next Up Episode","description":"Start playback of the top next-up episode for a user on a named active device session, after confirming current sessions and the user's next-up list.","mode":"mutating","inputs":{"profile":{"type":"string","required":false,"default":""},"device_name":{"type":"string","required":true,"description":"Exact case-insensitive active session device name, e.g. \"Geoffs TV\""},"username":{"type":"string","required":false,"default":"","description":"Jellyfin user whose next-up list is resolved (optional; auto-resolved when omitted)"}},"steps":[{"name":"sessions","title":"Active sessions","tool":"jellyfin","args":{"action":"list_sessions","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"},{"name":"next_up","title":"Next-up list","tool":"jellyfin","args":{"action":"next_up","profile":"${inputs.profile}","username":"${inputs.username}","limit":5,"start_index":0},"expect":"json","on_error":"continue"},{"name":"play","title":"Play on device","tool":"jellyfin_playback","args":{"action":"play","profile":"${inputs.profile}","device_name":"${inputs.device_name}","item_id":"${steps.next_up.json.items[0].id}"},"expect":"json","on_error":"fail"}],"result":{"sessions":"${steps.sessions.json}","next_up":"${steps.next_up.json}","play":"${steps.play.json}"},"tags":["jellyfin","playback","control"]}