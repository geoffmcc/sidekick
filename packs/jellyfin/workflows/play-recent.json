{"schema_version":1,"name":"jellyfin/play-recent","version":"1.0.0","title":"Jellyfin Play Most Recently Added","description":"Start playback of the most recently added Jellyfin item on a named active device session, after confirming current sessions.","mode":"mutating","inputs":{"profile":{"type":"string","required":false,"default":""},"device_name":{"type":"string","required":true,"description":"Exact case-insensitive active session device name, e.g. \"Geoffs TV\""},"include_item_types":{"type":"string","required":false,"default":"Episode,Movie"}},"steps":[{"name":"sessions","title":"Active sessions","tool":"jellyfin","args":{"action":"list_sessions","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"continue"},{"name":"recent","title":"Recently added","tool":"jellyfin","args":{"action":"recently_added","profile":"${inputs.profile}","include_item_types":"${inputs.include_item_types}","limit":1,"start":0},"expect":"json","on_error":"continue"},{"name":"play","title":"Play on device","tool":"jellyfin_playback","args":{"action":"play","profile":"${inputs.profile}","device_name":"${inputs.device_name}","item_id":"${steps.recent.json.items[0].id}"},"expect":"json","on_error":"fail"}],"result":{"sessions":"${steps.sessions.json}","recent":"${steps.recent.json}","play":"${steps.play.json}"},"tags":["jellyfin","playback","control"]}