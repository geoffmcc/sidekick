{"schema_version":1,"name":"jellyfin/session-overview","version":"1.0.0","title":"Jellyfin Session Overview","description":"Read-only active-session snapshot answering \"what is currently playing / who is watching what\": current sessions, playback diagnosis, and transcoding summary.","mode":"read_only","inputs":{"profile":{"type":"string","required":false,"default":""},"session_id":{"type":"string","required":false,"default":"","description":"Exact active session id to diagnose (optional)"}},"steps":[{"name":"sessions","title":"Playback sessions","tool":"jellyfin","args":{"action":"list_sessions","profile":"${inputs.profile}","limit":100},"expect":"json","on_error":"fail"},{"name":"diagnosis","title":"Playback diagnosis","tool":"jellyfin","args":{"action":"playback_diagnose","profile":"${inputs.profile}","session_id":"${inputs.session_id}"},"expect":"json","on_error":"continue"},{"name":"transcode","title":"Transcoding summary","tool":"jellyfin","args":{"action":"transcoding_summary","profile":"${inputs.profile}"},"expect":"json","on_error":"continue"}],"result":{"sessions":"${steps.sessions.json}","diagnosis":"${steps.diagnosis.json}","transcode":"${steps.transcode.json}"},"tags":["jellyfin","playback","read-only"]}