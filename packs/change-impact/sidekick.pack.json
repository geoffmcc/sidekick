{
  "schema_version": 1,
  "pack_api": 1,
  "name": "change-impact",
  "display_name": "Change Impact & Blast Radius",
  "version": "1.0.0",
  "description": "Evidence-backed change impact and blast-radius analysis using the Developer pack's diff and semantic repository primitives. This pack is read-only and does not infer runtime effects that are not evidenced by the repository.",
  "publisher": "Sidekick",
  "compatibility": { "sidekick": ">=1.0.0" },
  "modules": [{ "name": "change-impact-tools", "path": "modules/change-impact-tools", "entry_point": "entry.js", "config_from_pack": true }],
  "workflows": [{ "path": "workflows/blast-radius.json" }],
  "knowledge": [{ "path": "knowledge/blast-radius.md", "title": "Change Impact pack: blast-radius analysis", "category": "development", "tags": ["change-impact", "blast-radius", "semantic"] }, { "path": "knowledge/usage-reference.md", "title": "Change Impact: inputs and evidence limits", "category": "development", "tags": ["change-impact", "diff", "semantic", "evidence"] }],
  "requires": { "tools": ["dev_change_summary", "semantic_repo"], "optional_tools": ["snapshot", "health"] },
  "permissions": [{ "tool": "dev_change_summary", "risk": "low" }, { "tool": "semantic_repo", "risk": "low" }],
  "depends": { "packs": [{ "name": "developer", "version": ">=1.0.0" }] },
  "configuration": { "schema": { "type": "object", "properties": { "max_files": { "type": "integer", "minimum": 1, "maximum": 2000 } }, "additionalProperties": false }, "defaults": { "max_files": 500 } }
}
