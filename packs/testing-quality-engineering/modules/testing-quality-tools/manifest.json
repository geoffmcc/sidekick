{
  "name": "testing-quality-tools",
  "displayName": "Testing Quality Tools",
  "version": "1.0.0",
  "description": "Quality gates composed from the project's own verification and semantic repository tools.",
  "author": "Sidekick",
  "type": "plugin",
  "entryPoint": "entry.js",
  "sidekick": ">=1.0.0",
  "capabilities": ["quality-gates", "test-execution", "verification-planning", "semantic-test-coverage"],
  "tools": { "quality_gate": { "risk": "high", "category": "Development" }, "quality_health": { "risk": "low", "category": "Development" }, "quality_result_normalize": { "risk": "low", "category": "Development" }, "quality_lifecycle": { "risk": "high", "category": "Development" } },
  "permissions": [{ "tool": "dev_repo_profile", "risk": "low" }, { "tool": "dev_verify", "risk": "high" }, { "tool": "semantic_repo", "risk": "low" }],
  "lifecycle": { "disable": "stop_new_work", "uninstall": "retain_data" }
}
