{
  "schema_version": 1,
  "pack_api": 1,
  "name": "ci-cd-release-engineering",
  "display_name": "CI/CD & Release Engineering",
  "version": "1.0.0",
  "description": "Evidence-based CI diagnosis and release readiness without publishing or pushing.",
  "publisher": "Sidekick",
  "compatibility": { "sidekick": ">=1.0.0" },
  "modules": [{ "name": "ci-cd-release-tools", "path": "modules/ci-cd-release-tools", "entry_point": "entry.js", "config_from_pack": true }],
  "workflows": [{ "path": "workflows/ci-readiness.json" }, { "path": "workflows/release-gate.json" }, { "path": "workflows/release-verification.json" }],
  "knowledge": [{ "path": "knowledge/ci-cd-release-engineering.md", "title": "CI/CD and Release Engineering pack", "category": "development", "tags": ["ci", "release", "readiness", "deployment"] }, { "path": "knowledge/usage-reference.md", "title": "CI/CD and Release Engineering: workflow guide", "category": "development", "tags": ["ci", "release", "verification", "readiness"] }],
  "requires": { "tools": ["dev_repo_profile", "dev_verify", "changelog"], "optional_tools": [] },
  "permissions": [{ "tool": "dev_repo_profile", "risk": "low" }, { "tool": "dev_verify", "risk": "high" }, { "tool": "changelog", "risk": "medium" }],
  "configuration": { "schema": { "type": "object", "properties": { "verification_mode": { "type": "string", "enum": ["quick", "standard", "full"] } }, "additionalProperties": false }, "defaults": { "verification_mode": "standard" } }
}
