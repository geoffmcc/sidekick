{
  "schema_version": 1,
  "pack_api": 1,
  "name": "reproducibility",
  "display_name": "Reproducibility",
  "version": "1.0.0",
  "description": "Creates bounded, secret-safe reproducibility bundles from repository and platform evidence, using existing artifact custody and research evidence primitives.",
  "publisher": "Sidekick",
  "compatibility": { "sidekick": ">=1.0.0" },
  "modules": [{ "name": "reproducibility-tools", "path": "modules/reproducibility-tools", "entry_point": "entry.js", "config_from_pack": true }],
  "workflows": [{ "path": "workflows/create-bundle.json" }],
  "knowledge": [{ "path": "knowledge/bundles.md", "title": "Reproducibility: safe evidence bundles", "category": "development", "tags": ["reproducibility", "artifacts", "evidence"] }, { "path": "knowledge/usage-reference.md", "title": "Reproducibility: inputs, custody and limitations", "category": "development", "tags": ["reproducibility", "artifacts", "evidence", "redaction"] }],
  "requires": { "tools": ["dev_repo_profile", "semantic_repo", "research_evidence"], "optional_tools": ["snapshot", "hash"] },
  "permissions": [{ "tool": "dev_repo_profile", "risk": "low" }, { "tool": "semantic_repo", "risk": "low" }, { "tool": "research_evidence", "risk": "medium" }],
  "depends": { "packs": [{ "name": "developer", "version": ">=1.0.0" }, { "name": "security-research", "version": ">=1.2.0" }] },
  "configuration": { "schema": { "type": "object", "properties": { "max_chars": { "type": "integer", "minimum": 1000, "maximum": 60000 } }, "additionalProperties": false }, "defaults": { "max_chars": 30000 } }
}
