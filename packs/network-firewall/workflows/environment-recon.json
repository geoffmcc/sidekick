{
  "name": "network-firewall/environment-recon",
  "version": "1.0.0",
  "title": "Network/firewall environment reconnaissance",
  "mode": "read_only",
  "owner": "network-firewall",
  "description": "Collect a bounded provider summary, capabilities, interfaces, routes, DHCP, firewall, VPN, and health evidence.",
  "inputs": { "profile": { "type": "string", "required": false } },
  "steps": [
    { "name": "summary", "title": "Network summary", "tool": "network", "args": { "action": "summary", "profile": "${inputs.profile}" }, "expect": "json", "on_error": "fail" },
    { "name": "capabilities", "title": "Capability negotiation", "tool": "network", "args": { "action": "capabilities", "profile": "${inputs.profile}" }, "expect": "json", "on_error": "continue" },
    { "name": "firewall", "title": "Firewall policy", "tool": "firewall", "args": { "action": "rules", "profile": "${inputs.profile}" }, "expect": "json", "on_error": "continue" },
    { "name": "dhcp", "title": "DHCP state", "tool": "dhcp", "args": { "action": "status", "profile": "${inputs.profile}" }, "expect": "json", "on_error": "continue" },
    { "name": "vpn", "title": "VPN state", "tool": "vpn", "args": { "action": "status", "profile": "${inputs.profile}" }, "expect": "json", "on_error": "continue" }
  ],
  "result": { "summary": "${steps.summary.json}", "capabilities": "${steps.capabilities.json}", "firewall": "${steps.firewall.json}", "dhcp": "${steps.dhcp.json}", "vpn": "${steps.vpn.json}" },
  "tags": ["network", "firewall", "recon", "read-only"]
}
