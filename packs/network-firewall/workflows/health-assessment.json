{
  "name": "network-firewall/health-assessment",
  "version": "1.0.0",
  "title": "Network/firewall health assessment",
  "mode": "read_only",
  "owner": "network-firewall",
  "description": "Assess device, interfaces, routes, DHCP, firewall, and VPN evidence while retaining unknown and permission-limited states.",
  "inputs": { "profile": { "type": "string", "required": false, "default": "" } },
  "steps": [ { "name": "health", "title": "Health checks", "tool": "network", "args": { "action": "health", "profile": "${inputs.profile}" }, "expect": "json", "on_error": "fail" }, { "name": "summary", "title": "Health summary", "tool": "network", "args": { "action": "summary", "profile": "${inputs.profile}" }, "expect": "json", "on_error": "continue" } ],
  "result": { "health": "${steps.health.json}", "summary": "${steps.summary.json}" },
  "tags": ["network", "firewall", "health", "read-only"]
}
