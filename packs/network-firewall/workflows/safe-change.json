{
  "name": "network-firewall/safe-change",
  "version": "1.0.0",
  "title": "Network/firewall safe change",
  "owner": "network-firewall",
  "mode": "mutating",
  "description": "Run the provider-safe change lifecycle through the normal policy and approval path.",
  "inputs": { "profile": { "type": "string", "required": true }, "change_type": { "type": "string", "required": true }, "id": { "type": "string", "required": false, "default": "" }, "management_path": { "type": "string", "required": true } },
  "steps": [ { "name": "apply", "title": "Apply provider-safe change", "tool": "network_change", "args": { "action": "apply", "profile": "${inputs.profile}", "change_type": "${inputs.change_type}", "id": "${inputs.id}", "management_path": "${inputs.management_path}" }, "expect": "json", "on_error": "fail" } ]
}
