{
  "schema_version": 1,
  "pack_api": 1,
  "name": "infrastructure-as-code",
  "display_name": "Infrastructure as Code",
  "version": "1.0.0",
  "description": "Provider-authoritative infrastructure inspection and plan-only validation.",
