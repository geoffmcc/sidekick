{
  "schema_version": 1,
  "pack_api": 1,
  "name": "storage-filesystems",
  "display_name": "Storage & Filesystems",
  "version": "1.0.0",
  "description": "Bounded storage capacity, backend, volume, and host disk inspection through existing providers.",
  "publisher": "Sidekick",
  "compatibility": { "sidekick": ">=1.0.0" },
  "modules": [{ "name": "storage-filesystem-tools", "path": "modules/storage-filesystem-tools", "entry_point": "entry.js", "config_from_pack": true }],
  "workflows": [
    { "path": "workflows/storage-filesystems/storage-audit.json" },
    { "path": "workflows/storage-filesystems/volume-audit.json" }
  ],
  "knowledge": [{ "path": "knowledge/operating.md", "title": "Storage and Filesystems: operating model", "category": "operations", "tags": ["storage", "filesystems", "capacity", "volumes"] }],
  "requires": { "tools": ["status"], "optional_tools": ["proxmox", "containers"] },
  "permissions": [{ "tool": "status", "risk": "medium" }, { "tool": "proxmox", "risk": "low" }, { "tool": "containers", "risk": "low" }],
  "configuration": { "schema": { "type": "object", "properties": { "default_node": { "type": "string", "maxLength": 255 } }, "additionalProperties": false }, "defaults": {} }
}
