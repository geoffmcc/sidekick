{
  "name": "storage-filesystem-tools",
  "displayName": "Storage and Filesystem Tools",
  "version": "1.0.0",
  "description": "Governed host, Proxmox, and container storage inspection adapters.",
  "author": "Sidekick",
  "type": "plugin",
  "entryPoint": "entry.js",
  "sidekick": ">=1.0.0",
  "capabilities": ["storage-capacity", "storage-backend-audit", "volume-inventory"],
  "tools": {
    "storage_capacity_audit": { "risk": "low", "category": "Storage" },
    "storage_backend_audit": { "risk": "low", "category": "Storage" },
    "storage_volume_inventory": { "risk": "low", "category": "Storage" },
    "storage_threshold_check": { "risk": "low", "category": "Storage" }
  },
  "permissions": [{ "tool": "status", "risk": "medium" }, { "tool": "proxmox", "risk": "low" }, { "tool": "containers", "risk": "low" }],
  "lifecycle": { "disable": "stop_new_work", "uninstall": "retain_data" }
}
