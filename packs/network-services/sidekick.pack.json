{
  "schema_version": 1,
  "pack_api": 1,
  "name": "network-services",
  "display_name": "Network Services",
  "version": "1.0.0",
  "description": "Bounded network, DHCP, VPN, and Nginx service inspection with provider-governed changes.",
  "publisher": "Sidekick",
  "compatibility": { "sidekick": ">=1.0.0" },
  "modules": [{ "name": "network-services-tools", "path": "modules/network-services-tools", "entry_point": "entry.js", "config_from_pack": true }],
