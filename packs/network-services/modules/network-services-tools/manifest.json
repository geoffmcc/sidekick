{
  "name": "network-services-tools",
  "displayName": "Network Services Tools",
  "version": "1.0.0",
  "description": "Governed network, DHCP, VPN, and Nginx service adapters.",
  "author": "Sidekick",
  "type": "plugin",
  "entryPoint": "entry.js",
  "sidekick": ">=1.0.0",
  "capabilities": ["network-discovery", "dhcp-inspection", "vpn-inspection", "nginx-services"],
  "tools": {
    "network_service_audit": { "risk": "low", "category": "Network Services" },
    "network_connectivity_review": { "risk": "low", "category": "Network Services" },
    "network_nginx_operation": { "risk": "high", "category": "Network Services" }
  },
  "permissions": [{ "tool": "network", "risk": "low" }, { "tool": "dhcp", "risk": "low" }, { "tool": "vpn", "risk": "low" }, { "tool": "nginx", "risk": "high" }],
  "lifecycle": { "disable": "stop_new_work", "uninstall": "retain_data" }
}
