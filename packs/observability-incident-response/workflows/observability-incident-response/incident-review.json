{
  "schema_version": 1,
  "name": "observability-incident-response/incident-review",
  "version": "1.0.0",
  "title": "Incident evidence review",
  "description": "Read-only inspection or analysis of Black Box incident evidence.",
  "mode": "read_only",
  "inputs": { "action": { "type": "string", "required": true }, "incident_id": { "type": "string", "required": false }, "capture_id": { "type": "string", "required": false }, "query": { "type": "string", "required": false } },
  "steps": [{ "name": "review", "tool": "observability_incident_operation", "args": { "action": "${inputs.action}", "incident_id": "${inputs.incident_id}", "capture_id": "${inputs.capture_id}", "query": "${inputs.query}" }, "expect": "json", "on_error": "fail" }],
  "result": { "review": "${steps.review.json}" },
  "tags": ["observability", "incidents", "black-box", "evidence", "read-only"]
}
