{
  "schema_version": 1,
  "name": "security-lab-reproduction/lab-lifecycle",
  "version": "1.0.0",
  "title": "Security lab run lifecycle",
  "description": "Inspect a scope-bound research run or create a durable plan. Planning writes a run record in Sidekick; it does not execute probes.",
  "mode": "mutating",
  "inputs": { "action": { "type": "string", "required": true, "enum": ["plan", "status"] }, "run_id": { "type": "string", "required": false }, "snapshot_id": { "type": "string", "required": false }, "network_scope": { "type": "string", "required": false } },
  "steps": [{ "name": "lifecycle", "tool": "lab_run_lifecycle", "args": { "action": "${inputs.action}", "run_id": "${inputs.run_id}", "snapshot_id": "${inputs.snapshot_id}", "network_scope": "${inputs.network_scope}" }, "expect": "json", "on_error": "fail" }],
  "result": { "lifecycle": "${steps.lifecycle.json}" },
  "tags": ["security", "lab", "scope", "read-only"]
}
