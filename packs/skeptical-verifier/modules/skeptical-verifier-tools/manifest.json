{
  "name": "skeptical-verifier-tools",
  "displayName": "Skeptical Verifier Tools",
  "version": "1.0.0",
  "description": "Independent read-only repository and platform evidence verifier.",
  "author": "Sidekick",
  "type": "plugin",
  "entryPoint": "entry.js",
  "sidekick": ">=1.0.0",
  "capabilities": ["independent-verification", "read-only-verification"],
  "configSchema": { "type": "object", "additionalProperties": false },
  "tools": { "skeptical_verify": { "risk": "low", "category": "Verification", "aliases": ["independent_verify"] } },
  "permissions": [{ "tool": "dev_repo_profile", "risk": "low" }, { "tool": "semantic_repo", "risk": "low" }, { "tool": "health", "risk": "low" }, { "tool": "snapshot", "risk": "low" }],
  "lifecycle": { "disable": "stop_new_work", "uninstall": "retain_data" }
}
