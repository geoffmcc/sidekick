{
  "name": "container-operations-tools",
  "displayName": "Container Operations Tools",
  "version": "1.0.0",
  "description": "Safe Docker and Podman engine API operations with bounded output and governed lifecycle actions.",
  "author": "Sidekick",
  "type": "plugin",
  "entryPoint": "entry.js",
  "sidekick": ">=1.0.0",
  "capabilities": ["docker-operations", "podman-operations", "compose-inspection", "container-health", "container-updates"],
  "tools": {
    "containers": { "risk": "low", "category": "Infrastructure" },
    "container_lifecycle": { "risk": "high", "category": "Infrastructure" },
    "compose": { "risk": "low", "category": "Infrastructure" },
    "compose_mutation": { "risk": "high", "category": "Infrastructure" }
  },
  "permissions": [],
  "lifecycle": { "disable": "stop_new_work", "uninstall": "retain_data" }
}
