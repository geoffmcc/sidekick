{
  "name": "software-supply-chain-tools", "displayName": "Software Supply Chain Tools", "version": "1.0.0", "description": "Bounded manifest and repository integrity checks.", "author": "Sidekick", "type": "plugin", "entryPoint": "entry.js", "sidekick": ">=1.0.0",
