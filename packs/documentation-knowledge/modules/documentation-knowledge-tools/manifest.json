{
  "name": "documentation-knowledge-tools",
  "displayName": "Documentation and Knowledge Tools",
  "version": "1.0.0",
  "description": "Repository-grounded documentation and knowledge audits.",
  "author": "Sidekick",
  "type": "plugin",
  "entryPoint": "entry.js",
  "sidekick": ">=1.0.0",
  "capabilities": ["documentation-audit", "knowledge-grounding"],
  "tools": { "documentation_audit": { "risk": "low", "category": "Documentation" } },
  "permissions": [{ "tool": "semantic_repo", "risk": "low" }, { "tool": "knowledge", "risk": "low" }, { "tool": "parse", "risk": "low" }],
  "lifecycle": { "disable": "stop_new_work", "uninstall": "retain_data" }
}
