{
  "schema_version": 1,
  "name": "documentation-knowledge/documentation-audit",
  "version": "1.0.0",
  "title": "Documentation audit",
  "description": "Read-only repository documentation and knowledge audit.",
  "mode": "read_only",
  "inputs": { "path": { "type": "string", "required": true }, "topic": { "type": "string", "required": false } },
  "steps": [{ "name": "audit", "tool": "documentation_audit", "args": { "path": "${inputs.path}", "topic": "${inputs.topic}" }, "expect": "json", "on_error": "fail" }],
  "result": { "audit": "${steps.audit.json}" },
  "tags": ["documentation", "knowledge", "audit", "read-only"]
}
