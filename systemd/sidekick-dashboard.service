[Unit]
Description=Sidekick Dashboard
Requires=sidekick-mcp.service
After=network.target sidekick-mcp.service

[Service]
Type=simple
WorkingDirectory=/home/sidekick/sidekick
ExecStart=/usr/bin/node src/dashboard.js
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
RemoveIPC=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
# Bound process and thread creation per service cgroup; RLIMIT_NPROC is UID-wide.
TasksMax=256
User=sidekick
Group=sidekick
UMask=0077
Environment=NODE_ENV=production
Environment=SIDEKICK_SECRET_DIR=/etc/sidekick/secrets
EnvironmentFile=-/etc/sidekick/sidekick.env

[Install]
WantedBy=multi-user.target
