[Unit]
Description=Sidekick Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sidekick/sidekick
ExecStart=/usr/bin/node src/dashboard.js
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
User=sidekick
Group=sidekick
Environment=NODE_ENV=production
EnvironmentFile=-/etc/sidekick/sidekick.env

[Install]
WantedBy=multi-user.target
