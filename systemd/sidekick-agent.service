[Unit]
Description=Sidekick Agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sidekick/sidekick
ExecStart=/usr/bin/node src/agent.js
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
User=sidekick
Group=sidekick
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
