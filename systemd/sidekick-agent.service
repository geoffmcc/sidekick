[Unit]
Description=Sidekick Agent
Requires=sidekick-mcp.service
After=network.target sidekick-mcp.service

[Service]
Type=simple
WorkingDirectory=/home/sidekick/sidekick
ExecStart=/usr/bin/node src/agent.js
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
User=sidekick
Group=sidekick
Environment=NODE_ENV=production
Environment=SIDEKICK_SECRET_DIR=/etc/sidekick/secrets

[Install]
WantedBy=multi-user.target
