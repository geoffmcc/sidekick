[Unit]
Description=Sidekick Agent
Requires=sidekick-mcp.service
After=network.target sidekick-mcp.service

[Service]
Type=simple
WorkingDirectory=/home/sidekick/sidekick
ExecStart=/usr/bin/node src/agent.js
Restart=always
RestartSec=10
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
RemoveIPC=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
User=sidekick
Group=sidekick
UMask=0077
Environment=NODE_ENV=production
Environment=SIDEKICK_SECRET_DIR=/etc/sidekick/secrets

[Install]
WantedBy=multi-user.target
