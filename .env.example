# API key for MCP server authentication (used by opencode and agent bridge)
SIDEKICK_API_KEY=sk-your-key-here

# Optional production secret directory. When set, the six Sidekick secrets
# below are read from restrictive files instead of environment values. Files
# are named sidekick_api_key, sidekick_dashboard_pass,
# sidekick_grafana_admin_password, sidekick_influx_token,
# sidekick_postgres_password, and sidekick_secret_key.
# SIDEKICK_SECRET_DIR=/etc/sidekick/secrets

# IP whitelist for MCP server (comma-separated, 127.0.0.1/::1 always allowed)
SIDEKICK_ALLOWED_IPS=

# IP whitelist for dashboard (comma-separated, 127.0.0.1/::1 always allowed)
# Leave empty to disable (dashboard still protected by HTTP Basic Auth above)
SIDEKICK_DASHBOARD_ALLOWED_IPS=

# Ports for the three services
SIDEKICK_PORT=4097
SIDEKICK_DASHBOARD_PORT=4098
SIDEKICK_AGENT_PORT=4099

# Dashboard authentication (leave empty for no auth; required if dashboard is reachable beyond localhost)
SIDEKICK_DASHBOARD_USER=
SIDEKICK_DASHBOARD_PASS=

# Directory for logs, KV store, and conversation transcripts
SIDEKICK_DATA_DIR=/home/sidekick/sidekick/data

# SQLite database file (default: SIDEKICK_DATA_DIR/sidekick.db)
SIDEKICK_DB_FILE=

# Directory for database backups (default: data/backups)
SIDEKICK_BACKUP_DIR=

# Directory for schema migrations (default: migrations in repo root)
SIDEKICK_MIGRATIONS_DIR=

# Maximum retained tool log rows
SIDEKICK_MAX_LOG=1000

# Automatic memory summaries for useful tool calls and completed Agent Bridge tasks
# Set to 0/false/off to disable
SIDEKICK_AUTO_MEMORY=1
SIDEKICK_AUTO_MEMORY_MAX=500
SIDEKICK_EMBEDDINGS=1
SIDEKICK_EMBEDDING_MODEL=nomic-embed-text
# Optional Agent Bridge/Compute chat-model override; otherwise OLLAMA_MODEL is used.
SIDEKICK_AGENT_MODEL=

# Optional provider bootstrap controls and OpenAI-compatible provider settings.
# Compute registers these providers only when the corresponding credentials exist.
SIDEKICK_DISABLE_PROVIDER_BOOTSTRAP=0
SIDEKICK_DISABLE_OLLAMA_BOOTSTRAP=0
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# HTTPS endpoint used by sidekick_health to verify outbound DNS and TLS connectivity
SIDEKICK_HEALTHCHECK_URL=https://github.com

# Ollama API (local provider; Compute prefers eligible local/trusted providers)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional Groq cloud provider, registered by Compute when configured
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Required by sidekick_secret encrypted credential storage
SIDEKICK_SECRET_KEY=

# PostgreSQL connection (for sidekick_db_* tools with database='postgres').
# SIDEKICK_POSTGRES_URL overrides the discrete connection fields; otherwise the
# connection is built from the discrete fields below (defaults:
# 127.0.0.1:5432, user/database "sidekick"). A password is required — there is
# no default.
SIDEKICK_POSTGRES_URL=
#SIDEKICK_POSTGRES_HOST=127.0.0.1
#SIDEKICK_POSTGRES_PORT=5432
#SIDEKICK_POSTGRES_USER=sidekick
#SIDEKICK_POSTGRES_DB=sidekick

# Required if using docker/docker-compose.yml for bundled services
SIDEKICK_POSTGRES_PASSWORD=
SIDEKICK_INFLUX_URL=http://127.0.0.1:8086
SIDEKICK_INFLUX_TOKEN=
# Comma-separated exact hosts allowed to receive the Influx token. Add a
# trusted remote host explicitly if remote InfluxDB is intentional.
SIDEKICK_INFLUX_ALLOWED_HOSTS=localhost,127.0.0.1,::1,sidekick-influxdb
SIDEKICK_INFLUX_ORG=sidekick
SIDEKICK_INFLUX_BUCKET=sidekick
SIDEKICK_INFLUX_PASSWORD=
SIDEKICK_GRAFANA_ADMIN_USER=sidekick
# Grafana admin password — only needed for manual Grafana login or initial setup.
# The dashboard proxy uses Grafana Auth Proxy (X-WEBAUTH-USER header) instead of Basic Auth,
# so this password is NOT required for the proxy to work.
SIDEKICK_GRAFANA_ADMIN_PASSWORD=
SIDEKICK_GRAFANA_PORT=3000
# Compose-only Grafana public root URL.
SIDEKICK_GRAFANA_ROOT_URL=http://localhost:4098/grafana/

# Host identity used by Docker bind-mounted services. The setup/deployment
# scripts populate these from the sidekick account; keep them aligned when
# running Compose manually on a different host.
SIDEKICK_UID=
SIDEKICK_GID=

# Qdrant URL used for semantic memory embeddings.
SIDEKICK_QDRANT_URL=http://127.0.0.1:6333

# Allow web_fetch to reach loopback/private destinations. Metadata and link-local
# destinations remain refused even when enabled.
SIDEKICK_ALLOW_PRIVATE_FETCH=false

# Security Research pack: external private workspace, when that pack is enabled.
# SIDEKICK_RESEARCH_WORKSPACE=/srv/private-research

# --- Governed Browser Automation (src/browser/) -----------------------------
# The browser subsystem is enabled by default but launches nothing until used,
# and the Chromium runtime must be installed deliberately with
# `node scripts/install-browser.js`. Defaults are safe; every limit is clamped.
SIDEKICK_BROWSER_ENABLED=true
# Managed Chromium install path. Defaults to SIDEKICK_DATA_DIR/browser/ms-playwright
# (outside the app checkout so deploys don't remove it). Override only if needed.
# SIDEKICK_BROWSER_BROWSERS_PATH=
# Explicit Chromium executable path (skips discovery). Rarely needed.
# SIDEKICK_BROWSER_EXECUTABLE=
# Run headless (recommended on servers). Set false only for local debugging.
SIDEKICK_BROWSER_HEADLESS=true
# Allow browser sessions to reach loopback/private/LAN targets. Off by default;
# a session must ALSO pass allow_private_network=true, so this is a ceiling.
# Metadata and link-local addresses stay refused even when this is true.
SIDEKICK_BROWSER_ALLOW_PRIVATE_NETWORK=false
# Session and resource bounds (all clamped to safe ranges).
SIDEKICK_BROWSER_MAX_SESSIONS=3
SIDEKICK_BROWSER_MAX_PAGES=5
SIDEKICK_BROWSER_SESSION_TTL_MS=1800000
SIDEKICK_BROWSER_IDLE_TIMEOUT_MS=300000
SIDEKICK_BROWSER_NAV_TIMEOUT_MS=30000
SIDEKICK_BROWSER_ACTION_TIMEOUT_MS=10000
SIDEKICK_BROWSER_MAX_DOWNLOAD_BYTES=26214400
SIDEKICK_BROWSER_MAX_UPLOAD_BYTES=26214400
SIDEKICK_BROWSER_MAX_OUTPUT_CHARS=20000
SIDEKICK_BROWSER_MAX_SEQUENCE_STEPS=20
# Filesystem roots (path.delimiter-separated) from which the browser may upload
# files by path. Empty = path uploads disabled; upload registered artifacts
# instead. Path uploads are additionally subject to the tool path policy.
# SIDEKICK_BROWSER_UPLOAD_ROOTS=

# Dashboard rate limiting. Defaults are sized for the polling dashboard UI.
SIDEKICK_DASHBOARD_RATE_LIMIT_MAX=1500
SIDEKICK_DASHBOARD_RATE_LIMIT_WINDOW_MS=900000

# Redis connection (for sidekick_redis tool)
# Default: redis://127.0.0.1:6379
SIDEKICK_REDIS_URL=

# Max agent loop iterations (safety limit, dedup safeguard prevents runaway loops)
SIDEKICK_MAX_ITERATIONS=15

# Tool permission policy:
# - open: all tools are allowed unless blocked below (default/backward compatible)
# - restricted: high/critical risk tools are blocked unless explicitly allowed
SIDEKICK_TOOL_POLICY=open

# Comma-separated tool policy overrides. Entries can be tool names or risk:high/risk:critical.
# Global examples:
# SIDEKICK_BLOCKED_TOOLS=db_restore,evolve
# SIDEKICK_ALLOWED_TOOLS=read,search,get,risk:low
SIDEKICK_BLOCKED_TOOLS=
SIDEKICK_ALLOWED_TOOLS=

# Source-specific overrides for mcp, dashboard, and agent sources.
# SIDEKICK_AGENT_TOOL_POLICY=restricted
# SIDEKICK_AGENT_ALLOWED_TOOLS=read,search,get,respond
# Inspect effective policy with: tools({ action: "policy", source: "mcp,dashboard,agent" })
SIDEKICK_MCP_TOOL_POLICY=
SIDEKICK_MCP_BLOCKED_TOOLS=
SIDEKICK_MCP_ALLOWED_TOOLS=
SIDEKICK_DASHBOARD_TOOL_POLICY=
SIDEKICK_DASHBOARD_BLOCKED_TOOLS=
SIDEKICK_DASHBOARD_ALLOWED_TOOLS=
SIDEKICK_AGENT_TOOL_POLICY=
SIDEKICK_AGENT_BLOCKED_TOOLS=
SIDEKICK_AGENT_ALLOWED_TOOLS=

# Optional filesystem path guardrails. Defaults are open when unset.
# Entries are comma-separated absolute paths. A path matches the entry itself
# or any descendant. Denied paths win over allowed paths.
# SIDEKICK_ALLOWED_PATHS=/home/sidekick/sidekick,/home/sidekick/projects
# SIDEKICK_DENIED_PATHS=/home/sidekick/.ssh,/etc
SIDEKICK_ALLOWED_PATHS=
SIDEKICK_DENIED_PATHS=
SIDEKICK_MCP_ALLOWED_PATHS=
SIDEKICK_MCP_DENIED_PATHS=
SIDEKICK_DASHBOARD_ALLOWED_PATHS=
SIDEKICK_DASHBOARD_DENIED_PATHS=
SIDEKICK_AGENT_ALLOWED_PATHS=
SIDEKICK_AGENT_DENIED_PATHS=

# Optional approval queue. Default off preserves existing behavior.
# Enabling approvals requires SIDEKICK_SECRET_KEY so queued arguments can be encrypted.
# Pending approvals expire after one hour by default.
# Modes:
# - off: allowed tools execute immediately
# - risky: critical risk tools require dashboard approval unless exempted
# - strict: high/critical risk tools require dashboard approval unless exempted
# Entries can be tool names or risk:high/risk:critical.
SIDEKICK_APPROVAL_MODE=off
SIDEKICK_APPROVAL_TTL_SECONDS=3600
SIDEKICK_APPROVAL_REQUIRED_TOOLS=
SIDEKICK_APPROVAL_EXEMPT_TOOLS=
SIDEKICK_MCP_APPROVAL_MODE=
SIDEKICK_MCP_APPROVAL_REQUIRED_TOOLS=
SIDEKICK_MCP_APPROVAL_EXEMPT_TOOLS=
SIDEKICK_DASHBOARD_APPROVAL_MODE=
SIDEKICK_DASHBOARD_APPROVAL_REQUIRED_TOOLS=
SIDEKICK_DASHBOARD_APPROVAL_EXEMPT_TOOLS=
SIDEKICK_AGENT_APPROVAL_MODE=
SIDEKICK_AGENT_APPROVAL_REQUIRED_TOOLS=
SIDEKICK_AGENT_APPROVAL_EXEMPT_TOOLS=
